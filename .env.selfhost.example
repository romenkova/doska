# Self-hosting the full app from prebuilt images (docker-compose.selfhost.yml).
# Copy to .env and fill in. AUTH_LOGIN, AUTH_PASSWORD and AUTH_SECRET are
# required — the server has no defaults and won't start without them.

# Single-user credentials for the web UI and desktop sync.
AUTH_LOGIN=admin
AUTH_PASSWORD=change-me
# Long random string used to sign session tokens, e.g. `openssl rand -hex 32`.
AUTH_SECRET=

# This server's public origin — no trailing slash, e.g. http://192.168.1.10:8080
# or https://doska.example.com. Cookie-based sync works without it, but MCP
# OAuth advertises absolute URLs and needs it to point clients at the right host.
BASE_URL=

# Host port the web UI is published on (defaults to 8080).
WEB_PORT=8080

# --- HTTPS (optional) ---
# Set DOMAIN and start with `--profile https` to run a Caddy reverse proxy that
# fetches and renews a Let's Encrypt cert automatically. Point DNS for DOMAIN at
# this host first, and set BASE_URL=https://$DOMAIN above.
#   docker compose -f docker-compose.selfhost.yml --profile https up -d
# DOMAIN=doska.example.com

# --- Single sign-on (optional) ---
# Any OpenID Connect provider (Authentik, Keycloak, Pocket ID, Google). Register
# Doska there as a web app with the redirect URI
# $BASE_URL/api/auth/oauth2/callback/oidc and the openid, profile and email
# scopes, then set the issuer URL, client id and secret. Setting OIDC_ISSUER
# switches it on; the other two are then required. See
# https://doska.sh/docs/user-guides/sso
# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Name on the sign-in button, "Continue with <OIDC_NAME>". Defaults to SSO.
# OIDC_NAME=
# Set to off and signing in through the provider no longer creates accounts.
# OIDC_AUTO_CREATE=on

# Release channel / image tag to pull. `latest` = stable, `beta` = prerelease
# builds, or pin an exact version (e.g. 0.4.0) to freeze upgrades. The desktop
# app follows whatever version this server runs, so `beta` here also puts the
# connected desktop app on beta.
# DOCKER_IMAGE_TAG=latest

# --- Database ---
# By default Postgres is bundled (data lives in a Docker volume) and this
# password secures it. Leave DATABASE_URL commented to use it.
POSTGRES_PASSWORD=change-me

# To use your own managed Postgres instead, uncomment this and set it — the
# bundled db is then ignored.
# DATABASE_URL=postgres://user:password@db-host:5432/doska

# --- Attachments in S3 (optional) ---
# Setting S3_BUCKET moves attachments to s3, uses local volume when not specified
# The bucket stays private: uploads and downloads are proxied through
# the server, so credentials never reach the browser.
# S3_BUCKET=my-doska-attachments
# S3_REGION=us-east-1
# Credentials for a user/role with s3:PutObject, s3:GetObject, s3:DeleteObject.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# For S3-compatible stores (MinIO, Cloudflare R2), set the endpoint:
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Max upload size in bytes (default 25 MiB). Applies to either backend.
# FILE_MAX_BYTES=26214400
