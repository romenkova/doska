{
  "name": "landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node prerender/index.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@doska/docs": "workspace:*",
    "@doska/markdown": "workspace:*",
    "@doska/tokens": "workspace:*",
    "@doska/ui-kit": "workspace:*",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/mulish": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "clsx": "2.1.1",
    "lucide-react": "1.39.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4",
    "vfile": "^6.0.3",
    "vfile-matter": "^5.0.1"
  },
  "devDependencies": {
    "@doska/configs": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6",
    "vite": "^8.2.2"
  }
}
