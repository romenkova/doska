{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Doska",
  "version": "0.1.0",
  "identifier": "com.deck.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter client dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter client build",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Doska",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      },
      {
        "label": "quick-note",
        "title": "Quick note",
        "url": "/quick-note",
        "width": 768,
        "height": 440,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": true,
        "center": true,
        "dragDropEnabled": false
      },
      {
        "label": "tear-ghost",
        "title": "Doska",
        "url": "/tear-ghost.html",
        "width": 128,
        "height": 128,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "sidebarImage": "nsis/sidebar.bmp",
        "headerImage": "nsis/header.bmp"
      }
    },
    "publisher": "Margarita Romenkova",
    "homepage": "https://doska.sh",
    "shortDescription": "Offline-first kanban board with Markdown cards",
    "longDescription": "Doska is a kanban board that is quick, Markdown-first, minimal, and still feature-rich. Boards are stored locally first and sync shortly after every change to a folder on disk or to your own server.",
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/com.deck.desktop.metainfo.xml": "linux/com.deck.desktop.metainfo.xml"
        }
      },
      "deb": {
        "files": {
          "/usr/share/metainfo/com.deck.desktop.metainfo.xml": "linux/com.deck.desktop.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/com.deck.desktop.metainfo.xml": "linux/com.deck.desktop.metainfo.xml"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://deck.shpsm.dev/api/desktop/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCMUM1MjE5MUMwMzdBRkQKUldUOWVnTWNHVkljdSswVEtsVTVFdHhOS3VvWUdiVGYxdU52aGYvdS9tZStEa0llZ2x0MjB5eFcK"
    }
  }
}
