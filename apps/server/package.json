{
  "name": "server",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n db,api -c magenta,cyan \"pnpm db:serve\" \"DATABASE_URL=postgres://127.0.0.1:5432/postgres AUTH_TRUSTED_ORIGINS=http://localhost:5173 tsx watch --env-file-if-exists=.env src/index.ts\"",
    "start": "node --import tsx src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:serve": "tsx --env-file-if-exists=.env src/serve-dev.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@doska/contract": "workspace:*",
    "@doska/file-storage": "workspace:*",
    "@doska/mcp": "workspace:*",
    "@doska/merge": "workspace:*",
    "@doska/sync": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@orpc/server": "^1.15.4",
    "better-auth": "~1.6.30",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@doska/configs": "workspace:*",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@orpc/client": "^1.15.4",
    "@orpc/contract": "^1.15.4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6",
    "vitest": "^5.0.2"
  }
}
